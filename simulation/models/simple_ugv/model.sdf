<?xml version="1.0"?>
<!-- The one UGV definition. Worlds include it with model://simple_ugv and set only
     the spawn pose; do not paste a copy of this model into a world file. -->
<sdf version="1.9">
  <model name="simple_ugv" canonical_link="chassis">
    <!-- Known metric roof target; visual-only, fixed to the chassis. -->
    <include merge="true">
      <uri>model://ugv_fiducial</uri>
      <pose relative_to="chassis">0 0 0.12 0 0 0</pose>
    </include>
    <joint name="FiducialJoint" type="fixed">
      <parent>chassis</parent><child>fiducial_link</child>
    </joint>
    <link name="chassis">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.15</ixx><iyy>0.25</iyy><izz>0.30</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.8 0.5 0.18</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.8 0.5 0.18</size></box></geometry>
        <material>
          <ambient>0.12 0.38 0.72 1</ambient>
          <diffuse>0.12 0.38 0.72 1</diffuse>
        </material>
      </visual>
      <sensor name="imu" type="imu">
        <gz_frame_id>simple_ugv/chassis/imu</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/simple_ugv/imu</topic>
      </sensor>
      <sensor name="gps" type="navsat">
        <gz_frame_id>simple_ugv/chassis/gps</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/simple_ugv/gps</topic>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.30 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.008</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.30 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.008</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="left_wheel"/>
      <parent>chassis</parent><child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="right_wheel"/>
      <parent>chassis</parent><child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <!-- Front and rear ball casters keep the chassis level without adding drive.
         Both spheres (r = 0.08 m) sit on the ground directly under the chassis floor. -->
    <link name="front_caster">
      <pose>0.30 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_caster">
      <pose>-0.30 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_caster_joint" type="ball">
      <parent>chassis</parent><child>front_caster</child>
    </joint>
    <joint name="rear_caster_joint" type="ball">
      <parent>chassis</parent><child>rear_caster</child>
    </joint>
    <plugin filename="libugv_command_watchdog.so" name="ugv_control::CommandWatchdog">
      <input_topic>/simple_ugv/drive_cmd_vel</input_topic>
      <output_topic>/simple_ugv/cmd_vel</output_topic>
      <timeout>0.35</timeout>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/simple_ugv/cmd_vel</topic>
      <odom_topic>/simple_ugv/odom</odom_topic>
      <frame_id>simple_ugv/odom</frame_id>
      <child_frame_id>simple_ugv/chassis</child_frame_id>
    </plugin>
  </model>
</sdf>
