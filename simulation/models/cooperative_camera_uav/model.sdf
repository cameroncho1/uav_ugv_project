<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cooperative_camera_uav">
    <self_collide>false</self_collide>
    <include merge="true"><uri>model://x500</uri></include>
    <!-- FLU mount, exact pi/2 pitch; pixel optical axes are handled in YAML. -->
    <link name="camera_link">
      <pose>0 0 -0.18 0 1.5707963267948966 0</pose>
      <inertial><mass>0.05</mass><inertia>
        <ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz>
      </inertia></inertial>
      <sensor name="camera" type="camera">
        <gz_frame_id>uav/camera_optical_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image><width>1280</width><height>960</height></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>
  </model>
</sdf>
