<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="simple_goal_demo">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <scene>
      <grid>true</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.52 0.56 0.50 1</ambient>
            <diffuse>0.52 0.56 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="global_goal_marker">
      <static>true</static>
      <pose>4 0 0 0 0 0</pose>
      <link name="marker">
        <visual name="outer_target">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.8</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.55 0.02 1</ambient><diffuse>1 0.55 0.02 1</diffuse></material>
        </visual>
        <visual name="inner_ring">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.52</radius><length>0.012</length></cylinder></geometry>
          <!-- Visual-only goal annotation stays above the dark-obstacle threshold. -->
          <material><ambient>0.30 0.34 0.30 1</ambient><diffuse>0.30 0.34 0.30 1</diffuse></material>
        </visual>
        <visual name="goal_center">
          <pose>0 0 0.034 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.92 0.12 0.08 1</ambient><diffuse>0.92 0.12 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- generate_obstacle_worlds.py: layout 'dense'. Obstacles are dark so the
         camera luminance mapper marks them occupied. -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-2.6 1.3 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>-2.6 -1.3 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_3">
      <static>true</static>
      <pose>0.0 0.0 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.3</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_4">
      <static>true</static>
      <pose>0.0 2.6 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_5">
      <static>true</static>
      <pose>0.0 -2.6 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_6">
      <static>true</static>
      <pose>2.6 1.3 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_7">
      <static>true</static>
      <pose>2.6 -1.3 0.150 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.3 0.4 -0.85</direction>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>200</range><constant>1</constant></attenuation>
    </light>

    <!-- Shared vehicle: simulation/models/simple_ugv. Set only the spawn pose here. -->
    <include>
      <uri>model://simple_ugv</uri>
      <name>simple_ugv</name>
      <pose>-4 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
