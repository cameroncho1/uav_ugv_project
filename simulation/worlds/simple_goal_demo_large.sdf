<?xml version="1.0"?>
<sdf version="1.9">
  <world name="simple_goal_demo">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>true</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>70 50</size></plane></geometry>
          <material><ambient>0.52 0.56 0.50 1</ambient><diffuse>0.52 0.56 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="global_goal_marker">
      <static>true</static>
      <pose>24 14 0 0 0 0</pose>
      <link name="marker">
        <visual name="outer_target">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><cylinder><radius>1.0</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0.55 0.02 1</ambient><diffuse>1 0.55 0.02 1</diffuse></material>
        </visual>
        <visual name="goal_center">
          <pose>0 0 0.034 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.92 0.12 0.08 1</ambient><diffuse>0.92 0.12 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Scattered dark obstacles for the luminance mapper. The layout leaves
         multiple wide routes between the start at (-4, 0) and goal (24, 14). -->
    <model name="obstacle_01"><static>true</static><pose>1 3 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 3 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 3 0.8</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_02"><static>true</static><pose>5 -3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.2</radius><length>1</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.2</radius><length>1</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_03"><static>true</static><pose>8 4 0.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>3 1.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>3 1.5 0.7</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_04"><static>true</static><pose>11 -2 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.0</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.0</radius><length>0.9</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_05"><static>true</static><pose>14 5 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 2.5 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 2.5 0.8</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_06"><static>true</static><pose>18 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.3</radius><length>1</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.3</radius><length>1</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_07"><static>true</static><pose>21 7 0.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 1.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 1.5 0.7</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_08"><static>true</static><pose>4 10 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.1</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.1</radius><length>0.9</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_09"><static>true</static><pose>10 12 0.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 3 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 3 0.7</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>
    <model name="obstacle_10"><static>true</static><pose>16 11 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.2</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.2</radius><length>0.9</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link></model>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>1</intensity>
      <direction>-0.3 0.4 -0.85</direction><diffuse>0.95 0.95 0.95 1</diffuse>
    </light>
    <include>
      <uri>model://simple_ugv</uri><name>simple_ugv</name><pose>-4 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
