# Shell scripts run on Linux and must keep LF line endings, even when checked out on Windows.
*.sh text eol=lf
*.py text eol=lf

# Source digests used by supervisor conformance must survive cross-platform checkouts.
ros2_ws/src/ugv_control/include/ugv_control/supervisor*.hpp text eol=lf
ros2_ws/src/ugv_control/src/supervisor_transition_probe.cpp text eol=lf
ros2_ws/src/ugv_control/src/goal_controller.cpp text eol=lf
ros2_ws/src/uav_ugv_msgs/msg/FaultStatus.msg text eol=lf
config/fastdds_fixture_udp.xml text eol=lf

# Scenario executables and frozen input hashes must survive Windows checkouts.
ros2_ws/src/simulation_support/scripts/obstacle_scenario text eol=lf
ros2_ws/src/simulation_support/config/scenarios/*.yaml text eol=lf
