Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global map1
        - /Local grid1
      Splitter Ratio: 0.5
    Tree Height: 450
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.9
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Local grid
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_grid
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: A-star local path
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_path
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Global goal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_goal
    - Alpha: 1
      Arrow Length: 0.8
      Class: rviz_default_plugins/Pose
      Color: 80; 255; 80
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.12
      Name: Goal pose
      Shaft Length: 0.55
      Shaft Radius: 0.06
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_goal_pose
    - Alpha: 1
      Arrow Length: 0.8
      Class: rviz_default_plugins/Pose
      Color: 30; 180; 255
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.12
      Name: UGV pose
      Shaft Length: 0.55
      Shaft Radius: 0.06
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ugv_pose
    - Alpha: 0.25
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Reference grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Target Frame: <Fixed Frame>
      Yaw: 0.7
    Saved: ~