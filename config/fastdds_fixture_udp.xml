<?xml version="1.0" encoding="UTF-8"?>
<!-- Controlled numerical ROS fixtures avoid host shared-memory transport state.
     Camera/image trials retain fastdds_local_shm.xml for their larger payloads. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>fixture_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="numerical_fixture" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>fixture_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
