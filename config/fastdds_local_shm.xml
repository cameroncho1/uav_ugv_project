<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS transports for the single-host simulation.

     The drone camera publishes 1280x960 RGB images (about 3.7 MB) at 5 Hz. With the
     default transports these are split into UDP fragments, and the default Linux socket
     receive buffer (net.core.rmem_max, about 208 KB) overflows; losing one fragment drops
     the whole image. Measured on an ARM64 UTM VM: 5 Hz rendered in Gazebo, about 0.3 Hz
     received in ROS, so the camera map was stale and the UGV mostly waited.

     A 32 MB shared-memory segment carries whole images between local processes. UDP stays
     enabled for discovery and for any participant that does not load this profile.
     The goal-demo launch selects this file unless FASTRTPS_DEFAULT_PROFILES_FILE is set. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>local_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="local_large_messages" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>local_shm</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
