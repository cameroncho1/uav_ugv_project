# Saved evidence and report checksums must survive Windows/Linux checkouts.
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.svg text eol=lf
*.pdf binary
*.png binary
*.py text eol=lf
*.txt text eol=lf
*.sdf text eol=lf

# Generated worlds retain the exact bytes used by the simulator.
m3/search_worlds/*.sdf whitespace=-blank-at-eol
# Matplotlib SVG paths retain their generated bytes and artifact checksums.
m4/paper/figures/*.svg whitespace=-blank-at-eol
